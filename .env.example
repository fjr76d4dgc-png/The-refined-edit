# Copy this file to .env.local for local testing, and add the same values in Vercel → Settings → Environment Variables

# Your live site address (no trailing slash). Locally use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe → Developers → API keys (use sk_test_... until you're ready to go live)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Password you'll use to log in at /admin
ADMIN_PASSWORD=choose-a-long-password
# Any long random string (used to sign your admin login cookie)
ADMIN_SESSION_SECRET=paste-a-long-random-string-here
